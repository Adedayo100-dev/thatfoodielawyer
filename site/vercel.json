{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blank-2", "destination": "/consulting", "permanent": true },
    { "source": "/blog", "destination": "/ideas", "permanent": true },
    { "source": "/consult", "destination": "/consulting", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
